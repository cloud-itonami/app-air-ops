{
  "name": "kotodama-a1r0ps01",
  // Compiled from src/airops/worker.cljs by shadow-cljs (:target :esm).
  // Before the cljs migration this pointed at "svelte/.svelte-kit/cloudflare/_worker.js",
  // a SvelteKit build output that is NOT in this tree, while the TypeScript a reader
  // opened (src/app.ts) was in no bundle at all -- see docs/adr/0001.
  "main": "dist/worker.js",
  "compatibility_date": "2025-03-17",
  // nodejs_compat / nodejs_als were removed with the SvelteKit adapter that needed
  // them. Verified in workerd (`wrangler dev --local`) before removing, not assumed
  // -- docs/operator-quickstart.md S4.6.
  "vars": {
    "APP_CAPABILITIES": "[\"fileFlightPlan\",\"createDispatchBrief\",\"fetchNotam\"]",
    "APP_DESCRIPTION": "air-ops — airline flight operations and dispatch. Handles flight plan filing, dispatch briefs, NOTAMs, weather briefings, technical logs, fuel orders, PIREPs, and real-time flight monitoring.",
    "APP_DISPLAY_NAME": "Air Flight Operations",
    "APP_FRAMEWORK": "cljs-esm-worker",
    "APP_NANOID": "a1r0ps01",
    "APP_PERFORMER_TYPE": "service",
    "APP_UI_TYPE": "yoro",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.etzhayyim.com/xrpc/com.etzhayyim.mcp.message"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "a1r0ps01.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    },
    {
      "pattern": "air-ops.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    }
  ]
}
